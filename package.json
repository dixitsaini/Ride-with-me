{
  "name": "rider-app-foundation",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --watch=false",
    "firebase:emulators": "firebase emulators:start --project rider-app-emulator",
    "test:firebase": "firebase emulators:exec --project rider-app-emulator --only auth,firestore,database \"npm run test:firebase:jest\"",
    "test:firebase:jest": "jest --config jest.firebase.config.js --runInBand --watch=false",
    "test:rules": "npm run test:firebase",
    "format": "prettier --write .",
    "validate:ci": "npm run typecheck && npm run lint && npm test -- --watch=false"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~53.0.0",
    "expo-dev-client": "~5.2.4",
    "expo-location": "~18.1.6",
    "expo-notifications": "~0.31.5",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "expo-task-manager": "~13.1.6",
    "firebase": "^11.10.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@testing-library/jest-native": "^5.0.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.0",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "firebase-tools": "^14.27.0",
    "jest": "^29.7.0",
    "jest-expo": "^53.0.0",
    "prettier": "^3.3.5",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  }
}
